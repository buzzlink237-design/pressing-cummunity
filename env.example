RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM="The Pressing Community <beth.t@example.com>"
RESEND_TO=you@example.com

# BRAVO 2026 — Google Apps Script web app
# Paste scripts/bravo-apps-script.js into the Sheet (Extensions → Apps Script),
# deploy as Web app (Execute as: Me, Who has access: Anyone), then set the URL:
BRAVO_APPS_SCRIPT_URL=
# Optional shared secret (must match SCRIPT_SECRET in the Apps Script file)
BRAVO_APPS_SCRIPT_SECRET=

# Set to 1 to accept submissions before 21 Sept / after 25 Sept (tests only)
NEXT_PUBLIC_BRAVO_FORCE_OPEN=

# Social media — leave blank to hide that network on the site
NEXT_PUBLIC_SOCIAL_INSTAGRAM=https://www.instagram.com/lapressingcommunity
NEXT_PUBLIC_SOCIAL_FACEBOOK=https://www.facebook.com/lapressingcommunity
NEXT_PUBLIC_SOCIAL_YOUTUBE=https://www.youtube.com/@lapressingcommunity
NEXT_PUBLIC_SOCIAL_TIKTOK=
